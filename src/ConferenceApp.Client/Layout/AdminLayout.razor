@inherits LayoutComponentBase

<MudLayout>
    @* Eigene, dunklere Kopfleiste und Chip „Verwaltung“, damit der Admin-Bereich klar erkennbar ist. *@
    <MudAppBar Elevation="1" Class="admin-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" Class="mr-2"
                       OnClick="ToggleDrawer" aria-label="Menü ein-/ausblenden" />
        <MudLink Href="/admin" Color="Color.Inherit" Underline="Underline.None" Typo="Typo.h6">ConferenceApp</MudLink>
        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Inherit" Icon="@Icons.Material.Filled.AdminPanelSettings" Class="ml-3">Verwaltung</MudChip>
        <MudSpacer />
        <MudButton Href="/" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Public" Class="d-none d-sm-flex">Zur öffentlichen Seite</MudButton>
    </MudAppBar>

    @* Responsive: ab md persistent neben dem Inhalt, darunter temporär über dem Inhalt. *@
    <MudDrawer @bind-Open="_drawerOpen" Variant="DrawerVariant.Responsive" Breakpoint="Breakpoint.Md" ClipMode="DrawerClipMode.Always" Elevation="1">
        <MudNavMenu>
            <MudText Typo="Typo.overline" Class="px-4 pt-4">Verwaltung</MudText>
            <MudNavLink Href="/admin" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.EditCalendar">Konferenzen</MudNavLink>
            <MudNavLink Href="/admin/speaker" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ManageAccounts">Speaker</MudNavLink>
            <MudDivider Class="my-2" />
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Public">Zur öffentlichen Seite</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}
