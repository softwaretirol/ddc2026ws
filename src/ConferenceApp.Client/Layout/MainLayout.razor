@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider CloseOnEscapeKey="true" />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="() => _drawerOpen = !_drawerOpen" aria-label="Menü" />
        <MudText Typo="Typo.h6" Class="ml-2">ConferenceApp</MudText>
        <MudSpacer />
        <MudButton Href="/admin" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Settings">Admin</MudButton>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="1">
        <MudNavMenu>
            <MudText Typo="Typo.overline" Class="px-4 pt-4">Öffentlich</MudText>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Event">Konferenzen</MudNavLink>
            <MudNavLink Href="/speaker" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.RecordVoiceOver">Speaker</MudNavLink>
            <MudDivider Class="my-2" />
            <MudText Typo="Typo.overline" Class="px-4">Verwaltung</MudText>
            <MudNavLink Href="/admin" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.EditCalendar">Konferenzen verwalten</MudNavLink>
            <MudNavLink Href="/admin/speaker" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ManageAccounts">Speaker verwalten</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight { Primary = "#3949AB", Secondary = "#616161", AppbarBackground = "#283593" },

        // Typografie-Skala: h1 = Seitentitel (PageHeader), h2 = Abschnitt, h6 = Karten-/Unterabschnittstitel.
        Typography = new Typography
        {
            Default = new DefaultTypography { FontFamily = ["Roboto", "Helvetica", "Arial", "sans-serif"] },
            H1 = new H1Typography { FontSize = "1.75rem", FontWeight = "500", LineHeight = "1.25", LetterSpacing = "0" },
            H2 = new H2Typography { FontSize = "1.25rem", FontWeight = "500", LineHeight = "1.3", LetterSpacing = "0" },
            H6 = new H6Typography { FontSize = "1.125rem", FontWeight = "500", LineHeight = "1.35", LetterSpacing = "0" },
        },
    };
}
