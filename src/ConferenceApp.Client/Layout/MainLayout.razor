@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation

<a class="skip-link" href="#inhalt" @onclick="SkipToContentAsync" @onclick:preventDefault>Zum Inhalt springen</a>

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider CloseOnEscapeKey="true" />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="() => _drawerOpen = !_drawerOpen" aria-label="Menü" />
        <MudLink Href="/" Typo="Typo.h6" Color="Color.Inherit" Underline="Underline.None" Class="ml-2">ConferenceApp</MudLink>
        <MudSpacer />
        <MudButton Href="/admin" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Settings">Admin</MudButton>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="1">
        <MudNavMenu>
            <MudText Typo="Typo.overline" Class="px-4 pt-4">Öffentlich</MudText>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Event">Konferenzen</MudNavLink>
            <MudNavLink Href="/speaker" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.RecordVoiceOver">Speaker</MudNavLink>
            <MudDivider Class="my-2" />
            <MudText Typo="Typo.overline" Class="px-4">Verwaltung</MudText>
            <MudNavLink Href="/admin" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.EditCalendar">Konferenzen verwalten</MudNavLink>
            <MudNavLink Href="/admin/speaker" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ManageAccounts">Speaker verwalten</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <main id="inhalt" tabindex="-1" @ref="_main">
            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">
                @Body
            </MudContainer>
        </main>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private ElementReference _main;
    private string _path = "";
    private bool _focusMain;

    protected override void OnInitialized()
    {
        _path = CurrentPath();
        Navigation.LocationChanged += OnLocationChanged;
    }

    // Nach einer Navigation den Fokus auf den Inhalt setzen – beim ersten Laden nicht,
    // damit der erste Tab-Stopp der Skip-Link bleibt. Reine Query-/Fragment-Wechsel ignorieren.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var path = CurrentPath();
        if (path == _path) return;
        _path = path;
        _focusMain = true;
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusMain) return;
        _focusMain = false;
        await _main.FocusAsync();
    }

    private async Task SkipToContentAsync() => await _main.FocusAsync();

    private string CurrentPath() => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight { Primary = "#3949AB", Secondary = "#616161", AppbarBackground = "#283593" },
    };
}
