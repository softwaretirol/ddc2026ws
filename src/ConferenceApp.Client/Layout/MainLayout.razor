@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JS

@* Systemmodus beobachtet theme.js selbst; MudBlazor soll IsDarkMode nicht eigenmächtig umschalten. *@
<MudThemeProvider Theme="_theme" IsDarkMode="_isDarkMode" ObserveSystemDarkModeChange="false" />
<MudPopoverProvider />
<MudDialogProvider CloseOnEscapeKey="true" />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="() => _drawerOpen = !_drawerOpen" aria-label="Menü" />
        <MudText Typo="Typo.h6" Class="ml-2">ConferenceApp</MudText>
        <MudSpacer />
        <MudMenu Icon="@ModeIcon(_mode)" Color="Color.Inherit" AriaLabel="@MenuLabel"
                 AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true">
            @foreach (var mode in Enum.GetValues<ThemeMode>())
            {
                <MudMenuItem Icon="@ModeIcon(mode)" IconColor="@(mode == _mode ? Color.Primary : Color.Default)"
                             OnClick="() => SetModeAsync(mode)">
                    @ModeLabel(mode)
                </MudMenuItem>
            }
        </MudMenu>
        <MudButton Href="/admin" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Settings">Admin</MudButton>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="1">
        <MudNavMenu>
            <MudText Typo="Typo.overline" Class="px-4 pt-4">Öffentlich</MudText>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Event">Konferenzen</MudNavLink>
            <MudNavLink Href="/speaker" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.RecordVoiceOver">Speaker</MudNavLink>
            <MudDivider Class="my-2" />
            <MudText Typo="Typo.overline" Class="px-4">Verwaltung</MudText>
            <MudNavLink Href="/admin" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.EditCalendar">Konferenzen verwalten</MudNavLink>
            <MudNavLink Href="/admin/speaker" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ManageAccounts">Speaker verwalten</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private enum ThemeMode { System, Light, Dark }

    private bool _drawerOpen = true;
    private ThemeMode _mode = ThemeMode.System;
    private bool _systemDark;
    private bool _isDarkMode;
    private DotNetObjectReference<MainLayout>? _selfRef;

    // Einzige Stelle mit festen UI-Farben (neben den Shell-Farben in app.css); alles andere nutzt --mud-palette-*.
    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight { Primary = "#3949AB", Secondary = "#616161", AppbarBackground = "#283593" },
        // Hellere Primärfarbe für Kontrast auf dunklem Grund, dunkle Schrift auf gefüllten Primär-Flächen.
        PaletteDark = new PaletteDark { Primary = "#9FA8DA", PrimaryContrastText = "#1A237E", Secondary = "#BDBDBD" },
    };

    private string MenuLabel => "Farbschema: " + ModeLabel(_mode);

    protected override async Task OnInitializedAsync()
    {
        // Schon vor dem ersten Rendern lesen, damit die App nicht erst hell aufblitzt.
        try
        {
            _mode = await JS.InvokeAsync<string?>("conferenceTheme.getPreference") switch
            {
                "light" => ThemeMode.Light,
                "dark" => ThemeMode.Dark,
                _ => ThemeMode.System,
            };
            _systemDark = await JS.InvokeAsync<bool>("conferenceTheme.systemPrefersDark");
        }
        catch (JSException) { /* theme.js nicht verfügbar → Systemmodus, hell */ }

        await ApplyAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _selfRef = DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("conferenceTheme.watchSystem", _selfRef); }
        catch (JSException) { }
    }

    // Aufruf aus theme.js, wenn der Systemmodus wechselt; wirkt nur bei „Wie System“.
    [JSInvokable]
    public async Task OnSystemDarkModeChanged(bool isDark)
    {
        _systemDark = isDark;
        await ApplyAsync();
        StateHasChanged();
    }

    private async Task SetModeAsync(ThemeMode mode)
    {
        _mode = mode;
        try { await JS.InvokeVoidAsync("conferenceTheme.setPreference", PreferenceValue(mode)); }
        catch (JSException) { }
        await ApplyAsync();
    }

    private async Task ApplyAsync()
    {
        _isDarkMode = _mode switch
        {
            ThemeMode.Light => false,
            ThemeMode.Dark => true,
            _ => _systemDark,
        };
        try { await JS.InvokeVoidAsync("conferenceTheme.applyDarkMode", _isDarkMode); }
        catch (JSException) { }
    }

    private static string? PreferenceValue(ThemeMode mode) => mode switch
    {
        ThemeMode.Light => "light",
        ThemeMode.Dark => "dark",
        _ => null,
    };

    private static string ModeLabel(ThemeMode mode) => mode switch
    {
        ThemeMode.Light => "Hell",
        ThemeMode.Dark => "Dunkel",
        _ => "Wie System",
    };

    private static string ModeIcon(ThemeMode mode) => mode switch
    {
        ThemeMode.Light => Icons.Material.Filled.LightMode,
        ThemeMode.Dark => Icons.Material.Filled.DarkMode,
        _ => Icons.Material.Filled.BrightnessAuto,
    };

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("conferenceTheme.unwatchSystem"); }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
        _selfRef?.Dispose();
    }
}
