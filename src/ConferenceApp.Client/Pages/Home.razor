@page "/"
@inject ApiClient Api

<PageTitle>Konferenzen</PageTitle>

<PageHeader Title="Konferenzen" />

<PageState Loading="_conferences is null" Error="@_error" OnRetry="LoadAsync">
    <Skeleton>
        <MudGrid>
            @for (var i = 0; i < 3; i++)
            {
                <MudItem xs="12" sm="6" lg="4">
                    <MudCard Elevation="2" Class="h-100">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudSkeleton Width="70%" Height="32px" />
                                <MudSkeleton Width="50%" />
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudSkeleton />
                            <MudSkeleton Width="85%" />
                        </MudCardContent>
                        <MudCardActions>
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="110px" Height="36px" Class="rounded" />
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    </Skeleton>
    <ChildContent>
    @if (_conferences!.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Outlined.EventBusy" Title="Noch keine Konferenzen"
                    Text="Sobald eine Konferenz veröffentlicht ist, findest du hier ihre Agenda." />
    }
    else
    {
        <MudGrid>
            @foreach (var c in _conferences)
            {
                <MudItem xs="12" sm="6" lg="4">
                    <MudCard Elevation="2" Class="h-100 d-flex flex-column">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6">@c.Name</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    @Format.DateRange(c.StartDate, c.EndDate)@(c.Location is null ? "" : $" · {c.Location}")
                                </MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent Class="flex-grow-1">
                            <MudText Typo="Typo.body2">@c.Description</MudText>
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Href="@($"/konferenzen/{c.Slug}")" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CalendarMonth">Agenda</MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
    </ChildContent>
</PageState>

@code {
    private List<ConferenceDto>? _conferences;
    private string? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _error = null;
        try { _conferences = await Api.GetConferencesAsync(); }
        catch (ApiException ex) { _error = ex.Message; }
    }
}
