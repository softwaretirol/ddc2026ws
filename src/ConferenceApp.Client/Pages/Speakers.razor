@page "/speaker"
@inject ApiClient Api

<PageTitle>Speaker</PageTitle>

<PageHeader Title="Speaker" />

<PageState Loading="_speakers is null" Error="@_error" OnRetry="LoadAsync">
    <Skeleton>
        <MudGrid>
            @for (var i = 0; i < 8; i++)
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudCard Elevation="1" Class="h-100">
                        <MudCardHeader>
                            <CardHeaderAvatar><MudSkeleton SkeletonType="SkeletonType.Circle" Width="56px" Height="56px" /></CardHeaderAvatar>
                            <CardHeaderContent>
                                <MudSkeleton Width="70%" Height="28px" />
                                <MudSkeleton Width="50%" />
                            </CardHeaderContent>
                        </MudCardHeader>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    </Skeleton>
    <ChildContent>
    @if (_speakers!.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Outlined.RecordVoiceOver" Title="Noch keine Speaker"
                    Text="Sobald Speaker für eine Konferenz feststehen, stellen wir sie hier vor." />
    }
    else
    {
    <MudGrid>
        @foreach (var s in _speakers!)
        {
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Elevation="1" Class="h-100">
                    <MudCardHeader>
                        <CardHeaderAvatar><SpeakerAvatar Name="@s.Name" PhotoUrl="@s.PhotoUrl" Size="Size.Large" /></CardHeaderAvatar>
                        <CardHeaderContent>
                            <MudLink Href="@($"/speaker/{s.Id}")" Typo="Typo.h6">@s.Name</MudLink>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@s.Company</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
    }
    </ChildContent>
</PageState>

@code {
    private List<SpeakerDto>? _speakers;
    private string? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _error = null;
        try { _speakers = await Api.GetSpeakersAsync(); }
        catch (ApiException ex) { _error = ex.Message; }
    }
}
