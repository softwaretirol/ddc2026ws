@page "/konferenzen/{Slug}"
@inject ApiClient Api
@inject NavigationManager Nav

<PageTitle>@(_agenda?.Conference.Name ?? "Agenda")</PageTitle>

<PageState Loading="_agenda is null" Error="@_error">
    @{ var conf = _agenda!.Conference; }
    <MudBreadcrumbs Items="_breadcrumbs" Class="pa-0 mb-1" />

    <header class="agenda-header">
        <MudText Typo="Typo.h5" Class="agenda-header-title">@conf.Name</MudText>
        <div class="agenda-header-meta">
            <span><MudIcon Icon="@Icons.Material.Outlined.Event" Size="Size.Small" />@Format.DateRange(conf.StartDate, conf.EndDate)</span>
            @if (conf.Location is not null)
            {
                <span><MudIcon Icon="@Icons.Material.Outlined.Place" Size="Size.Small" />@conf.Location</span>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(conf.Description))
        {
            <MudText Typo="Typo.body2" Class="agenda-header-desc prewrap">@conf.Description</MudText>
        }
    </header>

    @* Eine Toolbar: Tage links, Suche, Track-Filter rechts *@
    <div class="agenda-toolbar">
        <div class="agenda-days" role="tablist">
            @foreach (var day in Format.Days(conf.StartDate, conf.EndDate))
            {
                var selected = day == _day;
                <MudButton Size="Size.Small" Variant="@(selected ? Variant.Filled : Variant.Text)" Color="Color.Primary"
                           DropShadow="false" role="tab" aria-selected="@(selected ? "true" : "false")"
                           OnClick="() => _day = day">@DayLabel(day)</MudButton>
            }
        </div>

        <MudTextField T="string" Value="_search" ValueChanged="OnSearchChanged" DebounceInterval="300"
                      Placeholder="Titel, Thema oder Speaker suchen…" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Clearable="true" Margin="Margin.Dense" Variant="Variant.Outlined" Class="agenda-search mt-0"
                      aria-label="Agenda durchsuchen" />

        @if (_agenda.Tracks.Count > 0)
        {
            <div class="agenda-tracks">
                <MudChip T="string" Size="Size.Small" Variant="@(_trackFilter is null ? Variant.Filled : Variant.Outlined)" Color="Color.Primary"
                         OnClick="() => _trackFilter = null">Alle Tracks</MudChip>
                @foreach (var t in _agenda.Tracks)
                {
                    <MudChip T="string" Size="Size.Small" Variant="@(_trackFilter == t.Id ? Variant.Filled : Variant.Outlined)"
                             Style="@($"border-color:{t.Color};" + (_trackFilter == t.Id ? $"background:{t.Color};color:#fff" : $"color:{t.Color}"))"
                             OnClick="() => _trackFilter = t.Id">@t.Name</MudChip>
                }
            </div>
        }
    </div>

    @if (IsSearching && SessionsFor(_day).Count == 0)
    {
        <MudAlert Severity="Severity.Info" Class="my-4">Keine Treffer für „@_search.Trim()“ an diesem Tag.</MudAlert>
    }
    else
    {
        <AgendaGrid Sessions="SessionsFor(_day)" Rooms="_agenda.Rooms" Slug="@Slug" />
    }
</PageState>

@code {
    [Parameter] public string Slug { get; set; } = "";

    /// <summary>Suchbegriff aus der URL (<c>?q=…</c>), damit Suchergebnisse teil- und verlinkbar sind.</summary>
    [SupplyParameterFromQuery(Name = "q")] public string? Query { get; set; }

    private AgendaDto? _agenda;
    private string? _loadedSlug;
    private string? _error;
    private int? _trackFilter;
    private DateOnly _day;
    private string _search = "";
    private List<BreadcrumbItem> _breadcrumbs = [];

    protected override async Task OnParametersSetAsync()
    {
        // Nur übernehmen, wenn die URL wirklich etwas anderes sagt – sonst würde z. B. ein
        // gerade getipptes Leerzeichen am Ende durch den getrimmten URL-Wert überschrieben.
        if ((Query ?? "") != _search.Trim()) _search = Query ?? "";

        // Eine reine Query-Änderung (?q=…) soll die Agenda nicht neu laden.
        if (Slug == _loadedSlug) { SelectDayWithHits(); return; }

        _agenda = null;
        _error = null;
        try
        {
            _agenda = await Api.GetAgendaAsync(Slug);
            _loadedSlug = Slug;
            _day = _agenda.Conference.StartDate;
            _breadcrumbs = [new("Konferenzen", "/"), new(_agenda.Conference.Name, null, disabled: true)];
            SelectDayWithHits();
        }
        catch (ApiException ex) { _error = ex.IsNotFound ? "Diese Konferenz gibt es nicht." : ex.Message; }
    }

    private bool IsSearching => !string.IsNullOrWhiteSpace(_search);

    private void OnSearchChanged(string? value)
    {
        _search = value ?? "";
        SelectDayWithHits();
        var q = IsSearching ? _search.Trim() : null;
        Nav.NavigateTo(Nav.GetUriWithQueryParameter("q", q), replace: true);
    }

    /// <summary>Hat der gewählte Tag keine Treffer, springt die Ansicht zum ersten Tag mit Treffern.</summary>
    private void SelectDayWithHits()
    {
        if (_agenda is null || !IsSearching || SessionsFor(_day).Count > 0) return;
        var first = Format.Days(_agenda.Conference.StartDate, _agenda.Conference.EndDate)
            .FirstOrDefault(d => SessionsFor(d).Count > 0);
        if (first != default) _day = first;
    }

    /// <summary>Während einer Suche steht die Trefferzahl am Tagesbutton („Di · 2“).</summary>
    private string DayLabel(DateOnly day) =>
        IsSearching ? $"{Format.Day(day)} · {SessionsFor(day).Count}" : Format.Day(day);

    private List<SessionDto> SessionsFor(DateOnly day) =>
        _agenda!.Sessions.Where(s => s.Day == day && (_trackFilter is null || s.TrackId == _trackFilter) && Matches(s)).ToList();

    /// <summary>Clientseitige Suche über Titel, Abstract und Speaker-Namen, ohne Groß-/Kleinschreibung.</summary>
    private bool Matches(SessionDto s)
    {
        if (!IsSearching) return true;
        var term = _search.Trim();
        return s.Title.Contains(term, StringComparison.OrdinalIgnoreCase)
            || (s.Abstract?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
            || s.Speakers.Any(sp => sp.Name.Contains(term, StringComparison.OrdinalIgnoreCase));
    }
}
