@page "/konferenzen/{Slug}"
@using System.Globalization
@inject ApiClient Api
@inject NavigationManager Nav

<PageTitle>@(_agenda?.Conference.Name ?? "Agenda")</PageTitle>

<PageState Loading="_agenda is null" Error="@_error" NotFound="_notFound" OnRetry="LoadAsync">
    <Skeleton>
        <MudSkeleton Width="160px" Class="mb-1" />
        <header class="page-header">
            <MudSkeleton Width="45%" Height="36px" />
            <MudSkeleton Width="30%" />
        </header>
        <div class="agenda-toolbar">
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="280px" Height="30px" Class="rounded" />
        </div>
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="420px" Class="rounded" />
    </Skeleton>
    <ChildContent>
    @{ var conf = _agenda!.Conference; }
    <PageHeader Title="@conf.Name" Breadcrumbs="_breadcrumbs" Description="@conf.Description">
        <Meta>
            <span><MudIcon Icon="@Icons.Material.Outlined.Event" Size="Size.Small" />@Format.DateRange(conf.StartDate, conf.EndDate)</span>
            @if (conf.Location is not null)
            {
                <span><MudIcon Icon="@Icons.Material.Outlined.Place" Size="Size.Small" />@conf.Location</span>
            }
        </Meta>
    </PageHeader>

    @* Eine Toolbar: Tage links, Track-Filter rechts. Die Auswahl steht in der URL (?tag=…&track=…). *@
    <div class="agenda-toolbar">
        <div class="agenda-days" role="tablist">
            @foreach (var day in Format.Days(conf.StartDate, conf.EndDate))
            {
                var selected = day == _day;
                <MudButton Size="Size.Small" Variant="@(selected ? Variant.Filled : Variant.Text)" Color="Color.Primary"
                           DropShadow="false" role="tab" aria-selected="@(selected ? "true" : "false")" Class="agenda-day"
                           OnClick="() => SelectDay(day)">@Format.DayShort(day)</MudButton>
            }
        </div>

        @if (_agenda.Tracks.Count > 0)
        {
            <div class="agenda-tracks" role="group" aria-label="Track-Filter">
                <MudChip T="string" Size="Size.Small" Variant="@(_trackFilter is null ? Variant.Filled : Variant.Outlined)" Color="Color.Primary"
                         role="button" aria-pressed="@(_trackFilter is null ? "true" : "false")"
                         OnClick="() => SelectTrack(null)">Alle Tracks</MudChip>
                @foreach (var t in _agenda.Tracks)
                {
                    <MudChip T="string" Size="Size.Small" Variant="@(_trackFilter == t.Id ? Variant.Filled : Variant.Outlined)"
                             Style="@TrackChipStyle(t)"
                             role="button" aria-pressed="@(_trackFilter == t.Id ? "true" : "false")"
                             OnClick="() => SelectTrack(t.Id)">@t.Name</MudChip>
                }
            </div>
        }
    </div>

    @* Kündigt Tag- und Filterwechsel für Screenreader an. *@
    <span class="sr-only" role="status" aria-live="polite">@FilterAnnouncement</span>

    @* Unter 768 px chronologische Liste, ab 768 px Raster. Umschaltung rein per CSS-Media-Query (app.css). *@
    @{ var daySessions = SessionsFor(_day); var markForAll = _trackFilter is not null; }
    <div class="agenda-view-list">
        <AgendaList Sessions="daySessions" Rooms="_agenda.Rooms" Slug="@Slug" MarkSessionsForAll="markForAll" />
    </div>
    <div class="agenda-view-grid">
        <AgendaGrid Sessions="daySessions" Rooms="_agenda.Rooms" Slug="@Slug" MarkSessionsForAll="markForAll" />
    </div>
    </ChildContent>
</PageState>

@code {
    private const string DayFormat = "yyyy-MM-dd";

    [Parameter] public string Slug { get; set; } = "";

    // Filterzustand kommt aus der URL: teilbar und übersteht einen Reload.
    // Weitere Parameter (z. B. q) lassen sich hier ergänzen; UpdateQuery lässt fremde Parameter unangetastet.
    [SupplyParameterFromQuery(Name = "tag")] public string? TagParam { get; set; }
    [SupplyParameterFromQuery(Name = "track")] public int? TrackParam { get; set; }

    private AgendaDto? _agenda;
    private string? _loadedSlug;
    private string? _error;
    private bool _notFound;
    private int? _trackFilter;
    private DateOnly _day;
    private List<BreadcrumbItem> _breadcrumbs = [];

    protected override async Task OnParametersSetAsync()
    {
        // Nur bei einer anderen Konferenz neu laden; reine Query-Änderungen (Filterwechsel) brauchen keinen API-Aufruf.
        if (Slug != _loadedSlug) await LoadAsync();
        else ApplyQuery();
    }

    // Lädt die Agenda (auch für „Erneut versuchen“ aus PageState) und wendet danach die URL-Auswahl an.
    private async Task LoadAsync()
    {
        _agenda = null;
        _error = null;
        _notFound = false;
        _loadedSlug = Slug;
        try
        {
            _agenda = await Api.GetAgendaAsync(Slug);
            _breadcrumbs = [new("Konferenzen", "/"), new(_agenda.Conference.Name, null, disabled: true)];
            ApplyQuery();
        }
        catch (ApiException ex)
        {
            _notFound = ex.IsNotFound;
            _error = ex.IsNotFound ? "Diese Konferenz gibt es nicht." : ex.Message;
        }
    }

    // Ungültige Werte oder Tage außerhalb der Konferenz fallen auf die Standardauswahl zurück.
    private void ApplyQuery()
    {
        if (_agenda is null) return;
        var conf = _agenda.Conference;
        _day = DateOnly.TryParseExact(TagParam, DayFormat, CultureInfo.InvariantCulture, DateTimeStyles.None, out var d)
               && d >= conf.StartDate && d <= conf.EndDate
            ? d
            : conf.StartDate;
        _trackFilter = TrackParam is { } id && _agenda.Tracks.Any(t => t.Id == id) ? id : null;
    }

    private void SelectDay(DateOnly day) => UpdateQuery(day, _trackFilter);

    private void SelectTrack(int? trackId) => UpdateQuery(_day, trackId);

    // Schreibt die Auswahl in die URL (ohne neuen History-Eintrag). Standardwerte (erster Tag, alle Tracks)
    // werden entfernt, andere Query-Parameter bleiben erhalten.
    private void UpdateQuery(DateOnly day, int? trackId)
    {
        var tag = day == _agenda!.Conference.StartDate ? null : day.ToString(DayFormat, CultureInfo.InvariantCulture);
        Nav.NavigateTo(Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["tag"] = tag,
            ["track"] = trackId,
        }), replace: true);
    }

    private string FilterAnnouncement
    {
        get
        {
            var track = _agenda?.Tracks.FirstOrDefault(t => t.Id == _trackFilter)?.Name;
            return track is null
                ? $"Agenda für {Format.Day(_day)}, alle Tracks"
                : $"Agenda für {Format.Day(_day)}, Track-Filter {track} aktiv, Sessions für alle bleiben sichtbar";
        }
    }

    // Track-Farbe nur für Rand/Fläche; Text in Textfarbe bzw. auf aktiver Fläche Schwarz/Weiß je nach Luminanz.
    private string TrackChipStyle(TrackDto t) =>
        _trackFilter == t.Id
            ? $"border-color:{t.Color};background:{t.Color};color:{ColorContrast.TextOn(t.Color)}"
            : $"border-color:{t.Color};color:var(--mud-palette-text-primary)";

    // Sessions ohne Track (Keynote, Closing Panel …) gelten für alle und bleiben bei aktivem Track-Filter sichtbar.
    private List<SessionDto> SessionsFor(DateOnly day) =>
        _agenda!.Sessions.Where(s => s.Day == day && (_trackFilter is null || s.TrackId is null || s.TrackId == _trackFilter)).ToList();
}
