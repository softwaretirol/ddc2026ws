@page "/konferenzen/{Slug}"
@inject ApiClient Api

<PageTitle>@(_agenda?.Conference.Name ?? "Agenda")</PageTitle>

<PageState Loading="_agenda is null" Error="@_error">
    @{ var conf = _agenda!.Conference; }
    <MudBreadcrumbs Items="_breadcrumbs" Class="px-0 pt-0" />
    <MudText Typo="Typo.h4">@conf.Name</MudText>
    <MudText Typo="Typo.subtitle1" Color="Color.Secondary" GutterBottom="true">
        @Format.DateRange(conf.StartDate, conf.EndDate)@(conf.Location is null ? "" : $" · {conf.Location}")
    </MudText>
    @if (!string.IsNullOrWhiteSpace(conf.Description))
    {
        <MudText Typo="Typo.body1" Class="mb-4 prewrap">@conf.Description</MudText>
    }

    @if (_agenda.Tracks.Count > 0)
    {
        <div class="d-flex flex-wrap gap-2 align-center mb-2">
            <MudText Typo="Typo.body2" Class="mr-2">Track:</MudText>
            <MudChip T="string" Variant="@(_trackFilter is null ? Variant.Filled : Variant.Outlined)" Color="Color.Primary"
                     OnClick="() => _trackFilter = null">Alle</MudChip>
            @foreach (var t in _agenda.Tracks)
            {
                <MudChip T="string" Variant="@(_trackFilter == t.Id ? Variant.Filled : Variant.Outlined)"
                         Style="@($"--track:{t.Color};border-color:{t.Color};" + (_trackFilter == t.Id ? $"background:{t.Color};color:#fff" : $"color:{t.Color}"))"
                         OnClick="() => _trackFilter = t.Id">@t.Name</MudChip>
            }
        </div>
    }

    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pt-4">
        @foreach (var day in Format.Days(conf.StartDate, conf.EndDate))
        {
            <MudTabPanel Text="@Format.Day(day)">
                <AgendaGrid Sessions="SessionsFor(day)" Rooms="_agenda.Rooms" Slug="@Slug" />
            </MudTabPanel>
        }
    </MudTabs>
</PageState>

@code {
    [Parameter] public string Slug { get; set; } = "";

    private AgendaDto? _agenda;
    private string? _error;
    private int? _trackFilter;
    private List<BreadcrumbItem> _breadcrumbs = [];

    protected override async Task OnParametersSetAsync()
    {
        _agenda = null;
        _error = null;
        try
        {
            _agenda = await Api.GetAgendaAsync(Slug);
            _breadcrumbs = [new("Konferenzen", "/"), new(_agenda.Conference.Name, null, disabled: true)];
        }
        catch (ApiException ex) { _error = ex.IsNotFound ? "Diese Konferenz gibt es nicht." : ex.Message; }
    }

    private List<SessionDto> SessionsFor(DateOnly day) =>
        _agenda!.Sessions.Where(s => s.Day == day && (_trackFilter is null || s.TrackId == _trackFilter)).ToList();
}
