@page "/konferenzen/{Slug}"
@inject ApiClient Api

<PageTitle>@(_agenda?.Conference.Name ?? "Agenda")</PageTitle>

<PageState Loading="_agenda is null" Error="@_error" NotFound="_notFound" OnRetry="LoadAsync">
    <Skeleton>
        <MudSkeleton Width="160px" Class="mb-1" />
        <header class="page-header">
            <MudSkeleton Width="45%" Height="36px" />
            <MudSkeleton Width="30%" />
        </header>
        <div class="agenda-toolbar">
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="280px" Height="30px" Class="rounded" />
        </div>
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="420px" Class="rounded" />
    </Skeleton>
    <ChildContent>
    @{ var conf = _agenda!.Conference; }
    <PageHeader Title="@conf.Name" Breadcrumbs="_breadcrumbs" Description="@conf.Description">
        <Meta>
            <span><MudIcon Icon="@Icons.Material.Outlined.Event" Size="Size.Small" />@Format.DateRange(conf.StartDate, conf.EndDate)</span>
            @if (conf.Location is not null)
            {
                <span><MudIcon Icon="@Icons.Material.Outlined.Place" Size="Size.Small" />@conf.Location</span>
            }
        </Meta>
    </PageHeader>

    @* Eine Toolbar: Tage links, Track-Filter rechts *@
    <div class="agenda-toolbar">
        <div class="agenda-days" role="tablist">
            @foreach (var day in Format.Days(conf.StartDate, conf.EndDate))
            {
                var selected = day == _day;
                <MudButton Size="Size.Small" Variant="@(selected ? Variant.Filled : Variant.Text)" Color="Color.Primary"
                           DropShadow="false" role="tab" aria-selected="@(selected ? "true" : "false")" Class="agenda-day"
                           OnClick="() => _day = day">@Format.DayShort(day)</MudButton>
            }
        </div>

        @if (_agenda.Tracks.Count > 0)
        {
            <div class="agenda-tracks">
                <MudChip T="string" Size="Size.Small" Variant="@(_trackFilter is null ? Variant.Filled : Variant.Outlined)" Color="Color.Primary"
                         OnClick="() => _trackFilter = null">Alle Tracks</MudChip>
                @foreach (var t in _agenda.Tracks)
                {
                    <MudChip T="string" Size="Size.Small" Variant="@(_trackFilter == t.Id ? Variant.Filled : Variant.Outlined)"
                             Style="@TrackChipStyle(t)"
                             OnClick="() => _trackFilter = t.Id">@t.Name</MudChip>
                }
            </div>
        }
    </div>

    <AgendaGrid Sessions="SessionsFor(_day)" Rooms="_agenda.Rooms" Slug="@Slug" />
    </ChildContent>
</PageState>

@code {
    [Parameter] public string Slug { get; set; } = "";

    private AgendaDto? _agenda;
    private string? _error;
    private bool _notFound;
    private int? _trackFilter;
    private DateOnly _day;
    private List<BreadcrumbItem> _breadcrumbs = [];

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _agenda = null;
        _error = null;
        _notFound = false;
        try
        {
            _agenda = await Api.GetAgendaAsync(Slug);
            _day = _agenda.Conference.StartDate;
            _breadcrumbs = [new("Konferenzen", "/"), new(_agenda.Conference.Name, null, disabled: true)];
        }
        catch (ApiException ex)
        {
            _notFound = ex.IsNotFound;
            _error = ex.IsNotFound ? "Diese Konferenz gibt es nicht." : ex.Message;
        }
    }

    // Track-Farbe nur für Rand/Fläche; Text in Textfarbe bzw. auf aktiver Fläche Schwarz/Weiß je nach Luminanz.
    private string TrackChipStyle(TrackDto t) =>
        _trackFilter == t.Id
            ? $"border-color:{t.Color};background:{t.Color};color:{ColorContrast.TextOn(t.Color)}"
            : $"border-color:{t.Color};color:var(--mud-palette-text-primary)";

    private List<SessionDto> SessionsFor(DateOnly day) =>
        _agenda!.Sessions.Where(s => s.Day == day && (_trackFilter is null || s.TrackId == _trackFilter)).ToList();
}
