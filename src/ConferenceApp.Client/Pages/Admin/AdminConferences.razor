@page "/admin"
@inject ApiClient Api
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Admin – Konferenzen</PageTitle>

<PageHeader Title="Konferenzen verwalten" Dense="true">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="() => EditAsync(null)">Neue Konferenz</MudButton>
    </Actions>
</PageHeader>

<PageState Loading="_items is null" Error="@_error" OnRetry="LoadAsync">
    <MudTable Items="_items" Hover="true" Elevation="1" Breakpoint="Breakpoint.Sm">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Slug</MudTh>
            <MudTh>Zeitraum</MudTh>
            <MudTh>Ort</MudTh>
            <MudTh Class="col-actions">Aktionen</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name"><MudLink Href="@($"/admin/konferenzen/{context.Id}")">@context.Name</MudLink></MudTd>
            <MudTd DataLabel="Slug">@context.Slug</MudTd>
            <MudTd DataLabel="Zeitraum">@Format.DateRange(context.StartDate, context.EndDate)</MudTd>
            <MudTd DataLabel="Ort">@context.Location</MudTd>
            <MudTd Class="col-actions">
                <MudTooltip Text="Agenda verwalten"><MudIconButton Icon="@Icons.Material.Filled.ViewTimeline" Href="@($"/admin/konferenzen/{context.Id}")" /></MudTooltip>
                <MudTooltip Text="Öffentliche Agenda"><MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Href="@($"/konferenzen/{context.Slug}")" /></MudTooltip>
                <MudTooltip Text="Bearbeiten"><MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="() => EditAsync(context)" /></MudTooltip>
                <MudTooltip Text="Löschen"><MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="() => DeleteAsync(context)" /></MudTooltip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <EmptyState Icon="@Icons.Material.Outlined.EventBusy" Title="Noch keine Konferenzen" Text="Lege die erste Konferenz an, um Tracks, Räume und Sessions zu planen.">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="() => EditAsync(null)">Neue Konferenz</MudButton>
            </EmptyState>
        </NoRecordsContent>
    </MudTable>
</PageState>

@code {
    private List<ConferenceDto>? _items;
    private string? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _error = null;
        try { _items = await Api.GetConferencesAsync(); }
        catch (ApiException ex) { _error = ex.Message; }
    }

    private async Task EditAsync(ConferenceDto? existing)
    {
        var model = existing is null
            ? new ConferenceRequest()
            : new ConferenceRequest
            {
                Name = existing.Name, Slug = existing.Slug, Description = existing.Description,
                StartDate = existing.StartDate, EndDate = existing.EndDate, Location = existing.Location,
            };

        ConferenceDto? saved = null;
        var parameters = new DialogParameters<ConferenceDialog>
        {
            { x => x.Model, model },
            { x => x.OnSave, async r => saved = existing is null ? await Api.CreateConferenceAsync(r) : await Api.UpdateConferenceAsync(existing.Id, r) },
        };

        if (await Dialogs.ShowFormAsync(existing is null ? "Neue Konferenz" : "Konferenz bearbeiten", parameters) && saved is not null)
        {
            Snackbar.AddSaved($"Konferenz „{saved.Name}“ gespeichert.", Navigation, $"/konferenzen/{saved.Slug}");
            await LoadAsync();
        }
    }

    private async Task DeleteAsync(ConferenceDto c)
    {
        if (await Dialogs.ConfirmDeleteAsync(Snackbar, $"Konferenz „{c.Name}“ inkl. aller Tracks, Räume und Sessions löschen?", () => Api.DeleteConferenceAsync(c.Id)))
            await LoadAsync();
    }
}
