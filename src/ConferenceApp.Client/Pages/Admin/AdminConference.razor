@page "/admin/konferenzen/{Id:int}"
@inject ApiClient Api
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Admin – @(_conference?.Name ?? "Konferenz")</PageTitle>

<PageState Loading="_conference is null" Error="@_error" NotFound="_notFound" OnRetry="LoadAsync" BackHref="/admin" BackText="Zur Konferenzverwaltung">
    <PageHeader Title="@_conference!.Name" Breadcrumbs="_breadcrumbs" Dense="true">
        <Meta>
            <span><MudIcon Icon="@Icons.Material.Outlined.Event" Size="Size.Small" />@Format.DateRange(_conference.StartDate, _conference.EndDate)</span>
            @if (_conference.Location is not null)
            {
                <span><MudIcon Icon="@Icons.Material.Outlined.Place" Size="Size.Small" />@_conference.Location</span>
            }
        </Meta>
        <Actions>
            <MudButton Href="@($"/konferenzen/{_conference.Slug}")" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.OpenInNew">Öffentliche Agenda</MudButton>
        </Actions>
    </PageHeader>

    <MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-4">
        <MudTabPanel Text="@($"Sessions ({_sessions.Count})")" Icon="@Icons.Material.Filled.Mic">
            <div class="d-flex mb-4">
                <MudSpacer />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="() => EditSessionAsync(null)"
                           Disabled="_rooms.Count == 0">Neue Session</MudButton>
            </div>
            @if (_rooms.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Class="mb-4">Lege zuerst mindestens einen Raum an.</MudAlert>
            }
            <MudTable Items="_sessions" Hover="true" Dense="true" Elevation="0" Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh>Tag</MudTh>
                    <MudTh>Zeit</MudTh>
                    <MudTh>Raum</MudTh>
                    <MudTh>Titel</MudTh>
                    <MudTh>Track</MudTh>
                    <MudTh>Speaker</MudTh>
                    <MudTh Class="col-actions">Aktionen</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Tag">@Format.DayShort(context.Day)</MudTd>
                    <MudTd DataLabel="Zeit">@Format.Range(context.StartTime, context.EndTime)</MudTd>
                    <MudTd DataLabel="Raum">@context.RoomName</MudTd>
                    <MudTd DataLabel="Titel">@context.Title</MudTd>
                    <MudTd DataLabel="Track">
                        @if (context.TrackName is not null) { <span class="color-dot" style="background:@context.TrackColor"></span>@context.TrackName }
                    </MudTd>
                    <MudTd DataLabel="Speaker">@string.Join(", ", context.Speakers.Select(s => s.Name))</MudTd>
                    <MudTd Class="col-actions">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="() => EditSessionAsync(context)" aria-label="Bearbeiten" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" aria-label="Löschen"
                                       OnClick="() => DeleteSessionAsync(context)" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText>Noch keine Sessions.</MudText></NoRecordsContent>
            </MudTable>
        </MudTabPanel>

        <MudTabPanel Text="@($"Tracks ({_tracks.Count})")" Icon="@Icons.Material.Filled.Label">
            <div class="d-flex mb-4">
                <MudSpacer />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="() => EditTrackAsync(null)">Neuer Track</MudButton>
            </div>
            <MudTable Items="_tracks" Hover="true" Dense="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Name</MudTh>
                    <MudTh>Farbe</MudTh>
                    <MudTh Class="col-actions">Aktionen</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Name"><span class="color-dot" style="background:@context.Color"></span>@context.Name</MudTd>
                    <MudTd DataLabel="Farbe">@context.Color</MudTd>
                    <MudTd Class="col-actions">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="() => EditTrackAsync(context)" aria-label="Bearbeiten" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" aria-label="Löschen"
                                       OnClick="() => DeleteTrackAsync(context)" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText>Noch keine Tracks.</MudText></NoRecordsContent>
            </MudTable>
        </MudTabPanel>

        <MudTabPanel Text="@($"Räume ({_rooms.Count})")" Icon="@Icons.Material.Filled.MeetingRoom">
            <div class="d-flex mb-4">
                <MudSpacer />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="() => EditRoomAsync(null)">Neuer Raum</MudButton>
            </div>
            <MudTable Items="_rooms" Hover="true" Dense="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Name</MudTh>
                    <MudTh>Kapazität</MudTh>
                    <MudTh Class="col-actions">Aktionen</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Name">@context.Name</MudTd>
                    <MudTd DataLabel="Kapazität">@context.Capacity</MudTd>
                    <MudTd Class="col-actions">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="() => EditRoomAsync(context)" aria-label="Bearbeiten" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" aria-label="Löschen"
                                       OnClick="() => DeleteRoomAsync(context)" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText>Noch keine Räume.</MudText></NoRecordsContent>
            </MudTable>
        </MudTabPanel>
    </MudTabs>
</PageState>

@code {
    [Parameter] public int Id { get; set; }

    private ConferenceDto? _conference;
    private List<SessionDto> _sessions = [];
    private List<TrackDto> _tracks = [];
    private List<RoomDto> _rooms = [];
    private List<SpeakerDto> _speakers = [];
    private string? _error;
    private bool _notFound;
    private List<BreadcrumbItem> _breadcrumbs = [];

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _error = null;
        _notFound = false;
        try
        {
            var conference = Api.GetConferenceAsync(Id);
            var sessions = Api.GetSessionsAsync(Id);
            var tracks = Api.GetTracksAsync(Id);
            var rooms = Api.GetRoomsAsync(Id);
            var speakers = Api.GetSpeakersAsync();
            await Task.WhenAll(conference, sessions, tracks, rooms, speakers);

            (_conference, _sessions, _tracks, _rooms, _speakers) = (conference.Result, sessions.Result, tracks.Result, rooms.Result, speakers.Result);
            _breadcrumbs = [new("Admin", "/admin"), new(_conference.Name, null, disabled: true)];
        }
        catch (ApiException ex)
        {
            _notFound = ex.IsNotFound;
            _error = ex.IsNotFound ? "Diese Konferenz gibt es nicht." : ex.Message;
        }
    }

    private async Task EditSessionAsync(SessionDto? s)
    {
        var model = s is null
            ? new SessionRequest { Day = DefaultSessionDay(), RoomId = DefaultSessionRoomId() }
            : new SessionRequest
            {
                Title = s.Title, Abstract = s.Abstract, Day = s.Day, StartTime = s.StartTime, EndTime = s.EndTime,
                RoomId = s.RoomId, TrackId = s.TrackId, SpeakerIds = s.Speakers.Select(x => x.Id).ToList(),
            };

        SessionDto? saved = null;
        var parameters = new DialogParameters<SessionDialog>
        {
            { x => x.Model, model },
            { x => x.Conference, _conference! },
            { x => x.Rooms, _rooms },
            { x => x.Tracks, _tracks },
            { x => x.Speakers, _speakers },
            { x => x.Sessions, _sessions },
            { x => x.SessionId, s?.Id },
            { x => x.OnSave, async r =>
                {
                    saved = s is null ? await Api.CreateSessionAsync(Id, r) : await Api.UpdateSessionAsync(Id, s.Id, r);
                    (_lastSessionDay, _lastSessionRoomId) = (r.Day, r.RoomId);
                } },
        };
        if (await Dialogs.ShowFormAsync(s is null ? "Neue Session" : "Session bearbeiten", parameters) && saved is not null)
            await AfterSaveAsync($"Session „{saved.Title}“ gespeichert.", $"/konferenzen/{_conference!.Slug}/sessions/{saved.Id}");
    }

    // Vorbelegung neuer Sessions: zuletzt gespeicherter Tag/Raum (sofern noch gültig), sonst erster Tag/erster Raum.
    // Die Uhrzeit schlägt der SessionDialog anhand der Raumbelegung vor.
    private DateOnly? _lastSessionDay;
    private int? _lastSessionRoomId;

    private DateOnly DefaultSessionDay() =>
        _lastSessionDay is { } d && d >= _conference!.StartDate && d <= _conference.EndDate ? d : _conference!.StartDate;

    private int DefaultSessionRoomId() =>
        _rooms.FirstOrDefault(r => r.Id == _lastSessionRoomId)?.Id ?? _rooms.FirstOrDefault()?.Id ?? 0;

    private async Task EditTrackAsync(TrackDto? t)
    {
        var model = t is null ? new TrackRequest() : new TrackRequest { Name = t.Name, Color = t.Color };
        TrackDto? saved = null;
        var parameters = new DialogParameters<TrackDialog>
        {
            { x => x.Model, model },
            { x => x.OnSave, async r => saved = t is null ? await Api.CreateTrackAsync(Id, r) : await Api.UpdateTrackAsync(Id, t.Id, r) },
        };
        if (await Dialogs.ShowFormAsync(t is null ? "Neuer Track" : "Track bearbeiten", parameters) && saved is not null)
            await AfterSaveAsync($"Track „{saved.Name}“ gespeichert.", AgendaUrl);
    }

    private async Task EditRoomAsync(RoomDto? room)
    {
        var model = room is null ? new RoomRequest() : new RoomRequest { Name = room.Name, Capacity = room.Capacity };
        RoomDto? saved = null;
        var parameters = new DialogParameters<RoomDialog>
        {
            { x => x.Model, model },
            { x => x.OnSave, async r => saved = room is null ? await Api.CreateRoomAsync(Id, r) : await Api.UpdateRoomAsync(Id, room.Id, r) },
        };
        if (await Dialogs.ShowFormAsync(room is null ? "Neuer Raum" : "Raum bearbeiten", parameters) && saved is not null)
            await AfterSaveAsync($"Raum „{saved.Name}“ gespeichert.", AgendaUrl);
    }

    private string AgendaUrl => $"/konferenzen/{_conference!.Slug}";

    private async Task AfterSaveAsync(string text, string href)
    {
        Snackbar.AddSaved(text, Navigation, href);
        await LoadAsync();
    }

    private Task DeleteSessionAsync(SessionDto s) => DeleteAsync($"Session „{s.Title}“ löschen?", () => Api.DeleteSessionAsync(Id, s.Id));
    private Task DeleteTrackAsync(TrackDto t) => DeleteAsync($"Track „{t.Name}“ löschen? Sessions bleiben ohne Track erhalten.", () => Api.DeleteTrackAsync(Id, t.Id));
    private Task DeleteRoomAsync(RoomDto r) => DeleteAsync($"Raum „{r.Name}“ löschen?", () => Api.DeleteRoomAsync(Id, r.Id));

    private async Task DeleteAsync(string text, Func<Task> delete)
    {
        if (await Dialogs.ConfirmDeleteAsync(Snackbar, text, delete))
            await LoadAsync();
    }
}
