@page "/speaker/{Id:int}"
@inject ApiClient Api

<PageTitle>@(_detail?.Speaker.Name ?? "Speaker")</PageTitle>

<PageState Loading="_detail is null" Error="@_error">
    @{ var sp = _detail!.Speaker; }
    <MudBreadcrumbs Items="_breadcrumbs" Class="px-0 pt-0" />

    <MudPaper Class="pa-6" Elevation="1">
        <div class="d-flex align-center gap-4 mb-4">
            <SpeakerAvatar Name="@sp.Name" PhotoUrl="@sp.PhotoUrl" Size="Size.Large" Decorative="true" />
            <div>
                <MudText Typo="Typo.h4">@sp.Name</MudText>
                <MudText Typo="Typo.subtitle1" Color="Color.Secondary">@sp.Company</MudText>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(sp.Bio))
        {
            <MudText Typo="Typo.body1" Class="prewrap mb-4">@sp.Bio</MudText>
        }

        @if (_links.Count > 0)
        {
            <div class="d-flex flex-wrap gap-2 mb-4">
                @foreach (var link in _links)
                {
                    if (link.Href is null)
                    {
                        @* Ungültige URL: nur als Text anzeigen, nicht verlinken *@
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.LinkOff">@link.Label</MudChip>
                    }
                    else
                    {
                        <MudButton Href="@link.Href" Target="_blank" Rel="noopener noreferrer" Variant="Variant.Outlined" Size="Size.Small"
                                   StartIcon="@link.Icon" EndIcon="@Icons.Material.Filled.OpenInNew" title="@($"{link.Href} (öffnet in neuem Tab)")">
                            @link.Label<span class="sr-only"> (öffnet in neuem Tab)</span>
                        </MudButton>
                    }
                }
            </div>
        }

        <MudText Typo="Typo.h6" GutterBottom="true">Sessions</MudText>
        @if (_detail.Sessions.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">Noch keine Sessions zugeordnet.</MudText>
        }
        else
        {
            @* Nach Konferenz gruppiert; Konferenzen mit kommenden Sessions zuerst *@
            @foreach (var group in _groups)
            {
                <div class="d-flex align-center gap-2 mt-3">
                    <MudLink Href="@($"/konferenzen/{group.Slug}")" Typo="Typo.subtitle1">@group.Name</MudLink>
                    @if (!group.Upcoming)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text">vergangen</MudChip>
                    }
                </div>
                <MudList T="string" Dense="true">
                    @foreach (var s in group.Sessions)
                    {
                        <MudListItem T="string" Href="@($"/konferenzen/{s.ConferenceSlug}/sessions/{s.Id}")" Icon="@Icons.Material.Filled.Mic">
                            <MudText Typo="Typo.subtitle1">@s.Title</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                @Format.Day(s.Day) · @Format.Range(s.StartTime, s.EndTime) · @s.RoomName
                            </MudText>
                        </MudListItem>
                    }
                </MudList>
            }
        }
    </MudPaper>
</PageState>

@code {
    [Parameter] public int Id { get; set; }

    private SpeakerDetailDto? _detail;
    private string? _error;
    private List<BreadcrumbItem> _breadcrumbs = [];
    private List<LinkView> _links = [];
    private List<SessionGroup> _groups = [];

    private sealed record LinkView(string? Href, string Label, string Icon);
    private sealed record SessionGroup(string Name, string Slug, bool Upcoming, List<SpeakerSessionDto> Sessions);

    protected override async Task OnParametersSetAsync()
    {
        _detail = null;
        _error = null;
        try
        {
            _detail = await Api.GetSpeakerAsync(Id);
            _breadcrumbs = [new("Speaker", "/speaker"), new(_detail.Speaker.Name, null, disabled: true)];
            _links = _detail.Speaker.Links.Where(l => !string.IsNullOrWhiteSpace(l)).Select(ToLinkView).ToList();
            _groups = GroupSessions(_detail.Sessions);
        }
        catch (ApiException ex) { _error = ex.IsNotFound ? "Diesen Speaker gibt es nicht." : ex.Message; }
    }

    /// <summary>
    /// Zeigt statt der vollen URL nur den Host (ohne "www.") und wählt das Icon nach Host.
    /// Fehlt das Schema, wird https angenommen; alles andere als http(s) gilt als ungültig und wird nicht verlinkt.
    /// </summary>
    private static LinkView ToLinkView(string raw)
    {
        var text = raw.Trim();
        if (!text.Contains("://")) text = "https://" + text;

        if (!Uri.TryCreate(text, UriKind.Absolute, out var uri)
            || (uri.Scheme != Uri.UriSchemeHttp && uri.Scheme != Uri.UriSchemeHttps)
            || string.IsNullOrEmpty(uri.Host))
        {
            return new LinkView(null, raw.Trim(), Icons.Material.Filled.LinkOff);
        }

        var host = uri.Host.StartsWith("www.", StringComparison.OrdinalIgnoreCase) ? uri.Host[4..] : uri.Host;
        var lower = host.ToLowerInvariant();
        var icon = lower == "github.com" ? Icons.Custom.Brands.GitHub
            : lower == "linkedin.com" || lower.EndsWith(".linkedin.com") ? Icons.Custom.Brands.LinkedIn
            : Icons.Material.Filled.Language;
        return new LinkView(uri.AbsoluteUri, host, icon);
    }

    /// <summary>
    /// Gruppiert nach Konferenz. Konferenzen mit kommenden Sessions zuerst (nächste zuerst),
    /// danach vergangene (jüngste zuerst). Innerhalb einer Konferenz chronologisch.
    /// </summary>
    private static List<SessionGroup> GroupSessions(List<SpeakerSessionDto> sessions)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        var groups = sessions
            .GroupBy(s => s.ConferenceSlug)
            .Select(g =>
            {
                var ordered = g.OrderBy(s => s.Day).ThenBy(s => s.StartTime).ToList();
                return new SessionGroup(ordered[0].ConferenceName, g.Key, ordered[^1].Day >= today, ordered);
            })
            .ToList();

        return groups.Where(g => g.Upcoming).OrderBy(g => g.Sessions[0].Day)
            .Concat(groups.Where(g => !g.Upcoming).OrderByDescending(g => g.Sessions[^1].Day))
            .ToList();
    }
}
