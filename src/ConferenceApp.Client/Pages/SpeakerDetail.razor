@page "/speaker/{Id:int}"
@inject ApiClient Api

<PageTitle>@(_detail?.Speaker.Name ?? "Speaker")</PageTitle>

<PageState Loading="_detail is null" Error="@_error" NotFound="_notFound" OnRetry="LoadAsync" BackHref="/speaker" BackText="Zu allen Speakern">
    <Skeleton>
        <MudSkeleton Width="200px" Class="mb-3" />
        <MudPaper Class="pa-6" Elevation="1">
            <div class="d-flex align-center gap-4 mb-4">
                <MudSkeleton SkeletonType="SkeletonType.Circle" Width="56px" Height="56px" />
                <div class="flex-grow-1">
                    <MudSkeleton Width="40%" Height="40px" />
                    <MudSkeleton Width="25%" />
                </div>
            </div>
            <MudSkeleton />
            <MudSkeleton />
            <MudSkeleton Width="70%" />
        </MudPaper>
    </Skeleton>
    <ChildContent>
    @{ var sp = _detail!.Speaker; }
    <PageHeader Title="@sp.Name" Breadcrumbs="_breadcrumbs">
        <Leading><SpeakerAvatar Name="@sp.Name" PhotoUrl="@sp.PhotoUrl" Size="Size.Large" /></Leading>
        <Meta>
            @if (!string.IsNullOrWhiteSpace(sp.Company))
            {
                <span>@sp.Company</span>
            }
        </Meta>
    </PageHeader>

    <MudPaper Class="pa-6" Elevation="1">
        @if (!string.IsNullOrWhiteSpace(sp.Bio))
        {
            <MudText Typo="Typo.body1" Class="prewrap mb-4">@sp.Bio</MudText>
        }

        @if (sp.Links.Count > 0)
        {
            <div class="d-flex flex-wrap gap-2 mb-4">
                @foreach (var link in sp.Links)
                {
                    <MudButton Href="@link" Target="_blank" Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Link">@link</MudButton>
                }
            </div>
        }

        <MudText Typo="Typo.h2" Class="mb-2">Sessions</MudText>
        @if (_detail.Sessions.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">Noch keine Sessions zugeordnet.</MudText>
        }
        else
        {
            <MudList T="string" Dense="true">
                @foreach (var s in _detail.Sessions)
                {
                    <MudListItem T="string" Href="@($"/konferenzen/{s.ConferenceSlug}/sessions/{s.Id}")" Icon="@Icons.Material.Filled.Mic">
                        <MudText Typo="Typo.subtitle1">@s.Title</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @s.ConferenceName · @Format.DayShort(s.Day) · @Format.Range(s.StartTime, s.EndTime) · @s.RoomName
                        </MudText>
                    </MudListItem>
                }
            </MudList>
        }
    </MudPaper>
    </ChildContent>
</PageState>

@code {
    [Parameter] public int Id { get; set; }

    private SpeakerDetailDto? _detail;
    private string? _error;
    private bool _notFound;
    private List<BreadcrumbItem> _breadcrumbs = [];

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _detail = null;
        _error = null;
        _notFound = false;
        try
        {
            _detail = await Api.GetSpeakerAsync(Id);
            _breadcrumbs = [new("Speaker", "/speaker"), new(_detail.Speaker.Name, null, disabled: true)];
        }
        catch (ApiException ex)
        {
            _notFound = ex.IsNotFound;
            _error = ex.IsNotFound ? "Diesen Speaker gibt es nicht." : ex.Message;
        }
    }
}
