<FormDialog TModel="TrackRequest" Model="Model" OnSave="OnSave">
    <MudTextField @bind-Value="Model.Name" For="@(() => Model.Name)" Label="Name" Required="true" AutoFocus="true" />
    <div class="d-flex align-center gap-3">
        <input type="color" @bind="Model.Color" aria-label="Farbe wählen" style="width:48px;height:40px;border:none;background:none;cursor:pointer" />
        <MudTextField @bind-Value="Model.Color" For="@(() => Model.Color)" Label="Farbe (#RRGGBB)" />
    </div>
</FormDialog>

@code {
    [Parameter] public TrackRequest Model { get; set; } = new();
    [Parameter] public Func<TrackRequest, Task> OnSave { get; set; } = default!;
}
