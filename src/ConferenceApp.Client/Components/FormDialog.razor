@typeparam TModel
@* Gemeinsamer Rahmen für alle Bearbeiten-Dialoge: Validierung, Speichern über die API, Fehleranzeige im Dialog. *@

<EditForm Model="Model" OnValidSubmit="SubmitAsync">
    <DataAnnotationsValidator />
    <MudDialog>
        <DialogContent>
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mb-3" ShowCloseIcon="true" CloseIconClicked="() => _error = null">@_error</MudAlert>
            }
            <MudStack Spacing="3">
                @ChildContent
            </MudStack>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="() => Dialog.Cancel()" Disabled="_saving">Abbrechen</MudButton>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving">
                @if (_saving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                Speichern
            </MudButton>
        </DialogActions>
    </MudDialog>
</EditForm>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter, EditorRequired] public TModel Model { get; set; } = default!;
    [Parameter, EditorRequired] public Func<TModel, Task> OnSave { get; set; } = default!;
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool _saving;
    private string? _error;

    private async Task SubmitAsync()
    {
        _saving = true;
        _error = null;
        try
        {
            await OnSave(Model);
            Dialog.Close(DialogResult.Ok(true));
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }
}
