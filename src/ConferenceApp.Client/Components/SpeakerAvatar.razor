@* Decorative="true", wenn der Name direkt daneben steht: Screenreader lesen den Namen dann nicht doppelt vor. *@
@if (!string.IsNullOrWhiteSpace(PhotoUrl))
{
    <MudAvatar Size="Size"><MudImage Src="@PhotoUrl" Alt="@(Decorative ? "" : Name)" /></MudAvatar>
}
else
{
    <MudAvatar Size="Size" Color="Color.Primary" aria-hidden="@(Decorative ? "true" : null)">@Initials</MudAvatar>
}

@code {
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string? PhotoUrl { get; set; }
    [Parameter] public Size Size { get; set; } = Size.Medium;
    [Parameter] public bool Decorative { get; set; }

    private string Initials => string.Concat(Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));
}
