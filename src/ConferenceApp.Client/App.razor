@* Provider und Theme liegen hier, damit PublicLayout und AdminLayout sie gemeinsam nutzen. *@
@implements IDisposable
@inject ThemeService ThemeState

@* Systemmodus beobachtet theme.js (über ThemeService); MudBlazor soll IsDarkMode nicht eigenmächtig umschalten. *@
<MudThemeProvider Theme="_theme" IsDarkMode="ThemeState.IsDarkMode" ObserveSystemDarkModeChange="false" />
<MudPopoverProvider />
<MudDialogProvider CloseOnEscapeKey="true" />
<MudSnackbarProvider />

<Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(PublicLayout)"/>
        @* Fokus nach Navigation setzen die Layouts (MainFocusLayoutBase) auf <main id="inhalt"> (nicht beim ersten Laden, damit der Skip-Link erster Tab-Stopp bleibt). *@
    </Found>
</Router>

@code {
    // Einzige Stelle mit festen UI-Farben (neben den Shell-Farben in app.css); alles andere nutzt --mud-palette-*.
    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight { Primary = "#3949AB", Secondary = "#616161", AppbarBackground = "#283593" },
        // Hellere Primärfarbe für Kontrast auf dunklem Grund, dunkle Schrift auf gefüllten Primär-Flächen.
        PaletteDark = new PaletteDark { Primary = "#9FA8DA", PrimaryContrastText = "#1A237E", Secondary = "#BDBDBD" },

        // Typografie-Skala: h1 = Seitentitel (PageHeader), h2 = Abschnitt, h6 = Karten-/Unterabschnittstitel.
        Typography = new Typography
        {
            Default = new DefaultTypography { FontFamily = ["Roboto", "Helvetica", "Arial", "sans-serif"] },
            H1 = new H1Typography { FontSize = "1.75rem", FontWeight = "500", LineHeight = "1.25", LetterSpacing = "0" },
            H2 = new H2Typography { FontSize = "1.25rem", FontWeight = "500", LineHeight = "1.3", LetterSpacing = "0" },
            H6 = new H6Typography { FontSize = "1.125rem", FontWeight = "500", LineHeight = "1.35", LetterSpacing = "0" },
        },
    };

    protected override async Task OnInitializedAsync()
    {
        ThemeState.Changed += OnThemeChanged;
        // Schon vor dem ersten Rendern lesen, damit die App nicht erst hell aufblitzt.
        await ThemeState.InitializeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await ThemeState.WatchSystemAsync();
    }

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => ThemeState.Changed -= OnThemeChanged;
}
